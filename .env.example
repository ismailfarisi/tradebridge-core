# Copy to .env for local dev. Env vars override these.
PORT=8080
GATEWAY_PORT=8081
DATABASE_URL=postgres://tradebridge:tradebridge@localhost:5442/tradebridge?sslmode=disable
REDIS_URL=redis://localhost:6389/0
JWT_SECRET=dev-secret-change-me
LOG_LEVEL=info

# --- Agent gateway hardening ---
# Credential TTL on issuance (days; 0 = never expires). Existing creds are
# grandfathered to a 90-day runway by migration 013.
AGENT_CRED_TTL_DAYS=90
# Grace window (days) a rotated-away credential's OLD secret keeps working.
AGENT_CRED_ROTATE_GRACE_DAYS=7
# Per-credential request cap (requests/minute) at the gateway.
AGENT_RL_PER_MIN=120
# Per-IP failed-auth attempts allowed within the window before a 429 block.
AGENT_AUTHFAIL_MAX=20
AGENT_AUTHFAIL_WINDOW_SEC=300
